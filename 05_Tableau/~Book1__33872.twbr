      <column caption='Customers' datatype='integer' name='[Calculation_2383530103754526721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([CustomerID])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_2383530104068792337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Monetary])' />
      </column>
      <column caption='Total Customer' datatype='integer' name='[Calculation_2383530104068956178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([CustomerID])' />
      </column>
      <column caption='AVG Order Value' datatype='real' name='[Calculation_2383530104069095443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Monetary]) / COUNTD([CustomerID])' />
      </column>
      <column caption='KPI Value' datatype='real' name='[Calculation_2383530104135819284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Total Revenue&apos;     THEN SUM([Monetary])&#13;&#10;WHEN &apos;Total Customers&apos;   THEN COUNTD([CustomerID])&#13;&#10;WHEN &apos;Avg Order Value&apos;   THEN SUM([Monetary]) / COUNTD([CustomerID])&#13;&#10;END' />
